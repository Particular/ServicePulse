{
  "name": "service-pulse",
  "version": "1.0.0",
  "type": "module",
  "description": "Production monitoring for distributed systems.",
  "main": "index.html",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:mocks": "cross-env NODE_ENV=dev-mocks vite",
    "build": "vite build",
    "type-check": "vue-tsc --build --force",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:component": "vitest run ./src",
    "test:coverage": "vitest run --coverage",
    "test:application:vitest": "npx vitest run ./test/specs",
    "test:application": "npm run test:application:vitest",
    "ai:setup": "impeccable install --project --providers=claude --yes"
  },
  "dependencies": {
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-xml": "6.1.0",
    "@codemirror/legacy-modes": "6.5.5",
    "@dagrejs/dagre": "3.1.3",
    "@fortawesome/fontawesome-svg-core": "7.3.1",
    "@fortawesome/free-brands-svg-icons": "7.3.1",
    "@fortawesome/free-regular-svg-icons": "7.3.1",
    "@fortawesome/free-solid-svg-icons": "7.3.1",
    "@fortawesome/vue-fontawesome": "3.3.3",
    "@tinyhttp/content-disposition": "2.2.4",
    "@vue-flow/controls": "1.1.3",
    "@vue-flow/core": "1.48.2",
    "@vue/devtools-api": "8.2.1",
    "@vueuse/core": "15.0.0",
    "bootstrap": "5.3.9",
    "codemirror": "6.0.2",
    "dayjs": "1.11.23",
    "diff": "9.0.0",
    "hex-to-css-filter": "7.0.0",
    "lossless-json": "4.3.4",
    "oidc-client-ts": "3.5.0",
    "pinia": "4.1.0",
    "vue": "3.5.46",
    "vue-codemirror6": "1.8.0",
    "vue-router": "5.5.1",
    "vue-tippy": "6.8.0",
    "vue-toastification": "2.0.0-rc.5",
    "vue3-cookies": "1.0.6",
    "vue3-simple-typeahead": "1.0.11",
    "xml-formatter": "3.7.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@pinia/testing": "2.0.2",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/user-event": "14.6.13",
    "@testing-library/vue": "8.1.0",
    "@tsconfig/node18": "18.2.8",
    "@types/bootstrap": "5.2.11",
    "@types/jsdom": "30.0.0",
    "@types/node": "26.6.6",
    "@vitejs/plugin-vue": "6.0.11",
    "@vitest/coverage-v8": "5.1.1",
    "@vue/tsconfig": "0.9.1",
    "cross-env": "10.1.0",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.7",
    "eslint-plugin-vue": "10.12.1",
    "globals": "17.14.0",
    "impeccable": "4.10.0",
    "jsdom": "31.0.1",
    "msw": "3.0.7",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vite": "8.3.8",
    "vite-plugin-checker": "1.0.0",
    "vite-plugin-vue-devtools": "8.2.1",
    "vitest": "5.1.1",
    "vue-tsc": "3.3.11"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  },
  "overrides": {
    "js-beautify": {
      "glob": "14.0.6"
    },
    "editorconfig": {
      "minimatch": "11.0.9"
    }
  }
